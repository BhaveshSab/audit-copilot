+  /** Atomically check freshness, mark, write provenance and record a receipt.
+   * An ambiguous network response can be retried with the SAME key/body.
+   * Replays reauthorize the caller but do not repeat writes or activity logs.
+   */
+  async applyCopilotDecision(
+    user: AuthUser,
+    id: string,
+    itemId: string,
+    dto: CopilotDecisionDto,
+  ) {
+    if (!this.isManager(user))
+      throw new ForbiddenException('Manager access required');
+    if (
+      dto.result !== AuditResult.VERIFIED &&
+      dto.result !== AuditResult.MISSING &&
+      dto.result !== AuditResult.DAMAGED
+    ) {
+      throw new BadRequestException('Invalid audit result');
+    }
+    const requestHash = createHash('sha256')
+      .update(
+        JSON.stringify({
+          id,
+          itemId,
+          expectedUpdatedAt: dto.expectedUpdatedAt,
+          result: dto.result,
+          notes: dto.notes,
+          evidenceRefs: dto.evidenceRefs,
+          policyRefs: dto.policyRefs,
+        }),
+      )
+      .digest('hex');
+    return this.prisma.$transaction(async (tx) => {
+      // Serialize both this path and ordinary marks/close on the cycle row.
+      await tx.$queryRaw`SELECT id FROM "AuditCycle" WHERE id=${id} FOR UPDATE`;
+      // Also serialize reuse of a key across DIFFERENT cycles.
+      await tx.$queryRaw`SELECT 1 AS locked FROM pg_advisory_xact_lock(hashtextextended(${user.id + ':' + dto.idempotencyKey}, 0))`;
+      const receipt = await tx.copilotDecision.findUnique({
+        where: {
+          actorId_idempotencyKey: {
+            actorId: user.id,
+            idempotencyKey: dto.idempotencyKey,
+          },
+        },
+      });
+      if (receipt) {
+        if (receipt.requestHash !== requestHash)
+          throw new ConflictException(
+            'Idempotency key reused with different input',
+          );
+        return receipt;
+      }
+      const cycle = await tx.auditCycle.findUnique({ where: { id } });
+      if (!cycle) throw new NotFoundException('Audit cycle not found');
+      if (cycle.status !== AuditCycleStatus.OPEN)
+        throw new ConflictException('Audit cycle is closed');
+      const item = await tx.auditItem.findUnique({
+        where: { id: itemId },
+        include: { asset: { select: ASSET_SELECT } },
+      });
+      if (!item || item.auditCycleId !== id)
+        throw new NotFoundException('Audit item not found');
+      if (
+        item.updatedAt.toISOString() !==
+        new Date(dto.expectedUpdatedAt).toISOString()
+      ) {
+        throw new ConflictException(
+          'Audit item changed; reinvestigate before approval',
+        );
+      }
+      await tx.auditItem.update({
+        where: { id: itemId },
+        data: {
+          result: dto.result,
+          notes: dto.notes,
+          auditedById: user.id,
+          auditedAt: new Date(),
+        },
+      });
+      const decision = await tx.copilotDecision.create({
+        data: {
+          actorId: user.id,
+          idempotencyKey: dto.idempotencyKey,
+          requestHash,
+          auditCycleId: id,
+          auditItemId: itemId,
+          result: dto.result,
+          notes: dto.notes,
+          evidenceRefs: dto.evidenceRefs,
+          policyRefs: dto.policyRefs,
+        },
+      });
+      await this.activity.log(
+        {
+          actorId: user.id,
+          action: 'audit.copilot_decision_applied',
+          entityType: 'AuditItem',
+          entityId: itemId,
+          metadata: {
+            auditCycleId: id,
+            decisionId: decision.id,
+            result: dto.result,
+            evidenceRefs: dto.evidenceRefs,
+            policyRefs: dto.policyRefs,
+          },
+        },
+        tx,
+      );
+      if (
+        dto.result === AuditResult.MISSING ||
+        dto.result === AuditResult.DAMAGED
+      ) {
+        await this.notifications.notifyAuditDiscrepancy(
+          {
+            assetId: item.assetId,
+            label: `${item.asset.name} (${item.asset.assetTag})`,
+            cycleName: cycle.name,
+            result: dto.result,
+            actorId: user.id,
+          },
+          tx,
+        );
+      }
+      return decision;
+    });
+  }
+
   // -------------------------------------------------------------------------
   // DISCREPANCY REPORT
   // -------------------------------------------------------------------------
