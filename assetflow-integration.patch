+++ b/backend/test/copilot.e2e-spec.ts
@@ -0,0 +1,203 @@
+import { INestApplication } from '@nestjs/common';
+import { randomUUID } from 'node:crypto';
+import request from 'supertest';
+import {
+  auth,
+  createAsset,
+  createTestApp,
+  createUserWithToken,
+  resetDatabase,
+  seedFixtures,
+} from './utils/test-app';
+import { PrismaService } from '../src/prisma/prisma.service';
+import { ActivityService } from '../src/activity/activity.service';
+
+describe('Copilot human decision contract (real API + PostgreSQL)', () => {
+  let app: INestApplication;
+  let token: string;
+  let employee: string;
+  let cycle: string;
+  let item: { id: string; updatedAt: string };
+  let body: Record<string, unknown>;
+  const path = () => `/api/audits/${cycle}/items/${item.id}/copilot-decisions`;
+  beforeAll(async () => {
+    app = await createTestApp();
+  });
+  afterAll(async () => {
+    await app.close();
+  });
+  beforeEach(async () => {
+    await resetDatabase(app);
+    await app.get(PrismaService).copilotDecision.deleteMany();
+    const fixtures = await seedFixtures(app);
+    token = (
+      await createUserWithToken(app, {
+        name: 'Reviewer',
+        email: 'reviewer@demo.test',
+        role: 'ADMIN',
+      })
+    ).token;
+    employee = (
+      await createUserWithToken(app, {
+        name: 'Employee',
+        email: 'employee@demo.test',
+      })
+    ).token;
+    await createAsset(app, {
+      name: 'Laptop',
+      assetTag: 'AF-COPILOT',
+      categoryId: fixtures.electronics.id,
+    });
+    const created = await request(app.getHttpServer())
+      .post('/api/audits')
+      .set(auth(token))
+      .send({
+        name: 'Copilot review',
+        startDate: new Date().toISOString(),
+        endDate: new Date(Date.now() + 86400000).toISOString(),
+      })
+      .expect(201);
+    cycle = created.body.id;
+    item = (
+      await request(app.getHttpServer())
+        .get(`/api/audits/${cycle}/items`)
+        .set(auth(token))
+        .expect(200)
+    ).body.items[0];
+    body = {
+      idempotencyKey: randomUUID(),
+      expectedUpdatedAt: item.updatedAt,
+      result: 'MISSING',
+      notes: 'Human confirmed absence; investigate transfer.',
+      evidenceRefs: ['E1'],
+      policyRefs: ['AF-04.1'],
+    };
+  });
+  it('atomically writes mark, receipt and activity; exact retry does not repeat', async () => {
+    await createUserWithToken(app, {
+      name: 'Manager recipient',
+      email: 'manager@demo.test',
+      role: 'ASSET_MANAGER',
+    });
+    const first = await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send(body)
+      .expect(200);
+    const retry = await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send(body)
+      .expect(200);
+    expect(retry.body.id).toBe(first.body.id);
+    const db = app.get(PrismaService);
+    expect(await db.copilotDecision.count()).toBe(1);
+    expect(
+      await db.notification.count({ where: { type: 'AUDIT_DISCREPANCY' } }),
+    ).toBe(1);
+    expect(
+      await db.activityLog.count({
+        where: { action: 'audit.copilot_decision_applied' },
+      }),
+    ).toBe(1);
+    expect(
+      (await db.auditItem.findUniqueOrThrow({ where: { id: item.id } })).result,
+    ).toBe('MISSING');
+  });
+  it('rolls back mark and receipt when provenance recording fails', async () => {
+    const spy = jest
+      .spyOn(app.get(ActivityService), 'log')
+      .mockRejectedValueOnce(new Error('Synthetic activity failure'));
+    try {
+      await request(app.getHttpServer())
+        .post(path())
+        .set(auth(token))
+        .send(body)
+        .expect(500);
+      const db = app.get(PrismaService);
+      expect(await db.copilotDecision.count()).toBe(0);
+      expect(
+        (await db.auditItem.findUniqueOrThrow({ where: { id: item.id } }))
+          .result,
+      ).toBe('PENDING');
+    } finally {
+      spy.mockRestore();
+    }
+  });
+  it('rejects changed payload reuse of a receipt key', async () => {
+    await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send(body)
+      .expect(200);
+    await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send({ ...body, notes: 'different' })
+      .expect(409);
+  });
+  it('rejects stale proposals without a mark or receipt', async () => {
+    await request(app.getHttpServer())
+      .patch(`/api/audits/${cycle}/items/${item.id}`)
+      .set(auth(token))
+      .send({ result: 'VERIFIED' })
+      .expect(200);
+    await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send(body)
+      .expect(409);
+    expect(await app.get(PrismaService).copilotDecision.count()).toBe(0);
+  });
+  it('rejects closed cycles', async () => {
+    await request(app.getHttpServer())
+      .post(`/api/audits/${cycle}/close`)
+      .set(auth(token))
+      .expect(200);
+    await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send(body)
+      .expect(409);
+  });
+  it('rejects unauthorized, anonymous, invalid and cross-cycle requests', async () => {
+    await request(app.getHttpServer()).post(path()).send(body).expect(401);
+    await request(app.getHttpServer())
+      .post(path())
+      .set(auth(employee))
+      .send(body)
+      .expect(403);
+    await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send({ ...body, result: 'PENDING' })
+      .expect(400);
+    await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send({ ...body, evidenceRefs: [] })
+      .expect(400);
+    await request(app.getHttpServer())
+      .post(`/api/audits/${cycle}/items/not-in-cycle/copilot-decisions`)
+      .set(auth(token))
+      .send(body)
+      .expect(404);
+  });
+  it('replays an existing receipt after closing without mutating the cycle', async () => {
+    const first = await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send(body)
+      .expect(200);
+    await request(app.getHttpServer())
+      .post(`/api/audits/${cycle}/close`)
+      .set(auth(token))
+      .expect(200);
+    const retry = await request(app.getHttpServer())
+      .post(path())
+      .set(auth(token))
+      .send(body)
+      .expect(200);
+    expect(retry.body.id).toBe(first.body.id);
+  });
+});
