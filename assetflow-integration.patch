+import { useState } from "react";
+import { copilotRequest, type CopilotFinding } from "@/lib/copilot";
+
+/** Opt-in investigation and explicit human review; never runs on page load. */
+export default function AuditCopilotPanel({
+  cycleId,
+  itemId,
+  onApplied,
+}: {
+  cycleId: string;
+  itemId: string;
+  onApplied: () => void;
+}) {
+  const [finding, setFinding] = useState<CopilotFinding | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [note, setNote] = useState("");
+  async function perform(action: () => Promise<void>) {
+    setBusy(true);
+    setError("");
+    try {
+      await action();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Copilot failed.");
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function investigate() {
+    const row = await copilotRequest<CopilotFinding>("/api/investigations", {
+      cycle_id: cycleId,
+      item_id: itemId,
+      question:
+        "Investigate this recorded audit result using custody, transfer, maintenance, disposal and human-review policies. Do not infer physical presence from system status.",
+    });
+    setFinding(row);
+    setNote("");
+  }
+  async function review(action: "approve" | "reject") {
+    if (!finding) return;
+    const row = await copilotRequest<CopilotFinding>(
+      `/api/findings/${finding.id}/review`,
+      { action, note },
+    );
+    setFinding(row);
+    if (row.state === "APPLIED") onApplied();
+  }
+  const f = finding?.payload.finding;
+  return (
+    <section
+      aria-label="Audit Copilot"
+      className="mt-3 space-y-3 rounded-lg border border-line bg-surface p-3 text-xs text-ink"
+    >
+      <p>
+        Audit Copilot proposes; you verify and approve. Investigating may send
+        scoped evidence to the configured LLM provider and incur API costs.
+      </p>
+      <button
+        type="button"
+        disabled={busy}
+        onClick={() => void perform(investigate)}
+        className="rounded border border-line px-3 py-2 disabled:opacity-50"
+      >
+        {busy ? "Working…" : "Investigate with Copilot"}
+      </button>
+      {error && (
+        <p role="alert" className="text-danger">
+          {error}
+        </p>
+      )}
+      {finding && f && (
+        <>
+          <p>
+            <strong>{finding.state}</strong> · {finding.payload.mode} ·{" "}
+            {f.category}
+          </p>
+          <p>{f.cause}</p>
+          <p>Proposed mark: {f.result ?? "None — refused"}</p>
+          <p>{f.recommended_action}</p>
+          <p>
+            Self-reported confidence: {Math.round(f.confidence * 100)}%. Not
+            calibrated accuracy.
+          </p>
+          {finding.payload.evidence.map((e) => (
+            <details key={e.id}>
+              <summary>
+                {e.id}: {e.tool}
+              </summary>
+              <pre className="whitespace-pre-wrap break-words">
+                {JSON.stringify(e.data, null, 2)}
+              </pre>
+            </details>
+          ))}
+          {f.policy_refs.map((r, i) => (
+            <blockquote key={i} className="border-l-2 border-info pl-2">
+              <strong>{r.clause_id}</strong> — {r.quote}
+            </blockquote>
+          ))}
+          <p>
+            Check source relevance and physical observations. Valid citations do
+            not prove the conclusion. The bundled corpus is authored
+            demonstration policy.
+          </p>
+          <label className="block">
+            Human review note
+            <textarea
+              aria-label="Human review note"
+              maxLength={2000}
+              value={note}
+              onChange={(e) => setNote(e.target.value)}
+              className="mt-1 block w-full rounded border border-line bg-canvas p-2"
+            />
+          </label>
+          <div className="flex gap-2">
+            <button
+              type="button"
+              disabled={
+                busy ||
+                !note.trim() ||
+                f.refused ||
+                !["AWAITING_REVIEW", "APPLYING"].includes(finding.state)
+              }
+              onClick={() => void perform(() => review("approve"))}
+              className="rounded border border-line px-3 py-2 disabled:opacity-50"
+            >
+              {finding.state === "APPLYING"
+                ? "Retry same approval"
+                : "Approve and apply"}
+            </button>
+            <button
+              type="button"
+              disabled={
+                busy || !note.trim() || finding.state !== "AWAITING_REVIEW"
+              }
+              onClick={() => void perform(() => review("reject"))}
+              className="rounded border border-line px-3 py-2 disabled:opacity-50"
+            >
+              Reject proposal
+            </button>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
