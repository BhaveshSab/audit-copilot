@@ -0,0 +1,43 @@
+import { AuditResult } from '@prisma/client';
+import {
+  ArrayMaxSize,
+  ArrayNotEmpty,
+  IsArray,
+  IsDateString,
+  IsIn,
+  IsString,
+  IsUUID,
+  MaxLength,
+  Matches,
+} from 'class-validator';
+
+/** Human-confirmed proposal only. The copilot has no privileged service token. */
+export class CopilotDecisionDto {
+  @IsUUID('4')
+  idempotencyKey: string;
+
+  @IsDateString()
+  expectedUpdatedAt: string;
+
+  @IsIn([AuditResult.VERIFIED, AuditResult.MISSING, AuditResult.DAMAGED])
+  result: AuditResult;
+
+  @IsString()
+  @MaxLength(4000)
+  @Matches(/\S/)
+  notes: string;
+
+  @IsArray()
+  @ArrayNotEmpty()
+  @ArrayMaxSize(24)
+  @IsString({ each: true })
+  @MaxLength(100, { each: true })
+  evidenceRefs: string[];
+
+  @IsArray()
+  @ArrayNotEmpty()
+  @ArrayMaxSize(8)
+  @IsString({ each: true })
+  @MaxLength(100, { each: true })
+  policyRefs: string[];
+}
