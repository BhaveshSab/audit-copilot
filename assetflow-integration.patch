+import { afterEach, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import AuditCopilotPanel from "./AuditCopilotPanel";
+import { saveSession } from "@/lib/session";
+
+const finding = {
+  id: "proposal",
+  state: "AWAITING_REVIEW",
+  payload: {
+    mode: "fixture",
+    finding: {
+      category: "missing",
+      result: "MISSING",
+      cause: "Review custody",
+      confidence: 0.5,
+      recommended_action: "Ask custodian",
+      refused: false,
+      policy_refs: [{ clause_id: "AF-04.1", quote: "Human review required" }],
+    },
+    evidence: [{ id: "E1", tool: "get_asset", data: { status: "ALLOCATED" } }],
+  },
+};
+function login() {
+  saveSession({
+    token: "delegated",
+    user: {
+      id: "u",
+      name: "Reviewer",
+      email: "u@test.invalid",
+      role: "ADMIN",
+      status: "ACTIVE",
+      departmentId: null,
+    },
+  });
+}
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+describe("Audit Copilot integration", () => {
+  it("does not investigate on render, sends a delegated JWT, and requires a human note", async () => {
+    login();
+    const fetchMock = vi
+      .fn()
+      .mockResolvedValue({ ok: true, json: async () => finding });
+    vi.stubGlobal("fetch", fetchMock);
+    const changed = vi.fn();
+    render(
+      <AuditCopilotPanel cycleId="cycle" itemId="item" onApplied={changed} />,
+    );
+    expect(fetchMock).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByText("Investigate with Copilot"));
+    await screen.findByText("Review custody");
+    expect(fetchMock.mock.calls[0][0]).toBe("/copilot-api/api/investigations");
+    expect(fetchMock.mock.calls[0][1].headers.Authorization).toBe(
+      "Bearer delegated",
+    );
+    expect(screen.getByText("Approve and apply")).toBeDisabled();
+    fireEvent.change(screen.getByLabelText("Human review note"), {
+      target: { value: "Physical absence confirmed" },
+    });
+    fetchMock.mockResolvedValue({
+      ok: true,
+      json: async () => ({ ...finding, state: "APPLIED" }),
+    });
+    fireEvent.click(screen.getByText("Approve and apply"));
+    await waitFor(() => expect(changed).toHaveBeenCalledOnce());
+    expect(JSON.parse(fetchMock.mock.calls[1][1].body)).toEqual({
+      action: "approve",
+      note: "Physical absence confirmed",
+    });
+  });
+  it("never offers application for refused findings", async () => {
+    login();
+    vi.stubGlobal(
+      "fetch",
+      vi
+        .fn()
+        .mockResolvedValue({
+          ok: true,
+          json: async () => ({
+            ...finding,
+            state: "REFUSED",
+            payload: {
+              ...finding.payload,
+              finding: {
+                ...finding.payload.finding,
+                result: null,
+                refused: true,
+              },
+            },
+          }),
+        }),
+    );
+    render(
+      <AuditCopilotPanel cycleId="cycle" itemId="item" onApplied={() => {}} />,
+    );
+    fireEvent.click(screen.getByText("Investigate with Copilot"));
+    await screen.findByText("Review custody");
+    fireEvent.change(screen.getByLabelText("Human review note"), {
+      target: { value: "Try anyway" },
+    });
+    expect(screen.getByText("Approve and apply")).toBeDisabled();
+  });
+  it("shows service failures without reporting success", async () => {
+    login();
+    vi.stubGlobal(
+      "fetch",
+      vi
+        .fn()
+        .mockResolvedValue({
+          ok: false,
+          status: 409,
+          json: async () => ({ detail: "Evidence changed; reinvestigate" }),
+        }),
+    );
+    render(
+      <AuditCopilotPanel cycleId="cycle" itemId="item" onApplied={() => {}} />,
+    );
+    fireEvent.click(screen.getByText("Investigate with Copilot"));
+    expect(await screen.findByRole("alert")).toHaveTextContent(
+      "Evidence changed; reinvestigate",
+    );
+  });
+});
