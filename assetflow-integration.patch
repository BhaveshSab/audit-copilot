+name: Audit Copilot isolated acceptance
+on:
+  push:
+    paths: ['audit-copilot/**', 'backend/src/audits/**', 'backend/src/notifications/**', 'src/components/dashboard/Audit*', 'src/lib/copilot.ts', 'src/vite-env.d.ts', 'vite.config.ts', 'backend/prisma/**', 'backend/test/copilot.e2e-spec.ts', '.github/workflows/audit-copilot.yml']
+  pull_request:
+    paths: ['audit-copilot/**', 'backend/src/audits/**', 'backend/src/notifications/**', 'src/components/dashboard/Audit*', 'src/lib/copilot.ts', 'src/vite-env.d.ts', 'vite.config.ts', 'backend/prisma/**', 'backend/test/copilot.e2e-spec.ts', '.github/workflows/audit-copilot.yml']
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  acceptance:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    env:
+      OTEL_SDK_DISABLED: 'true'
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - name: Install locked Python dependencies
+        run: |
+          python -m pip install -r audit-copilot/requirements.lock
+          python -m pip install --no-deps -e audit-copilot
+      - name: Python safety and fixture tests (no paid API)
+        run: python -m pytest audit-copilot/tests -q
+      - name: Build review interface
+        run: npm ci --prefix audit-copilot/ui && npm run build --prefix audit-copilot/ui
+      - name: Test AssetFlow review integration
+        run: npm ci && npm run build && npm test -- --run src/components/dashboard/AuditCopilotPanel.spec.tsx
+      - name: Build actual AssetFlow integration
+        run: |
+          npm ci --prefix backend
+          npm run prisma:generate --prefix backend
+          npm run build --prefix backend
+          npm ci --prefix audit-copilot/integration
+      - name: Real API and PostgreSQL decision contract
+        run: npm run test:e2e --prefix backend -- --runInBand copilot.e2e-spec.ts --silent
+      - name: Real MCP, PostgreSQL FTS and pgvector acceptance (fixture LLM only)
+        env:
+          COPILOT_PYTHON: python
+        run: npm test --prefix audit-copilot/integration
+      - name: Fixture evaluation harness (NOT model-quality proof)
+        working-directory: audit-copilot
+        run: python -m audit_copilot.evaluate
+      - uses: actions/upload-artifact@v4
+        with:
+          name: copilot-synthetic-fixture-evaluation
+          path: audit-copilot/artifacts/evaluation.json
+          retention-days: 7
