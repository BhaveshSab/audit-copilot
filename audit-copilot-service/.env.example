# Copy to .env privately. Never commit values or send them in chat.
COPILOT_MODE=demo
ASSETFLOW_URL=http://127.0.0.1:3000/api
COPILOT_STATE_PATH=artifacts/copilot.db
# Live mode requires a dedicated pgvector DB, ingested corpus, and API keys.
COPILOT_DATABASE_URL=
COPILOT_DB_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_FALLBACK=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
# Optional prices you verify yourself; missing prices remain null, never $0.
# COPILOT_PRICES_JSON={"openai":{"input_per_million":0,"output_per_million":0}}
